# Copy this file to .env and fill in real values. Never commit the real .env.

# Gmail address that will send and receive contact form messages
EMAIL_USER=belloriliwan001@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your16characterapppassword

# Comma-separated list of origins allowed to call this API
# Add your local dev URL and your deployed Vercel URL/custom domain
CLIENT_ORIGIN=http://localhost:5173,https://belloriliwan.dev

# Port the server listens on (Render sets this automatically in production)
PORT=5000
